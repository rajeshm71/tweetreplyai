{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/email-nudges",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/dispatch-campaigns",
      "schedule": "*/30 * * * *"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
