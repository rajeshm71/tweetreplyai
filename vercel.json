{
  "version": 2,
  "buildCommand": "npm run build",
  "builds": [
    {
      "src": "dist/prod.js",
      "use": "@vercel/node"
    },
    {
      "src": "dist/public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/dist/prod.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*\\.css)$",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/prod.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
