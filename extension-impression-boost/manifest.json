{
  "manifest_version": 3,
  "name": "Impression Boost",
  "version": "1.0.0",
  "description": "Randomized page auto-refresh for X (Twitter) and LinkedIn to boost impressions. No account required.",

  "permissions": ["storage"],

  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://www.linkedin.com/*",
    "https://linkedin.com/*"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Impression Boost",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://*.x.com/*",
        "https://*.twitter.com/*",
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": ["content/content.bundle.js"],
      "run_at": "document_end"
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
