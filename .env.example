# Required in production:
#   - SESSION_SECRET
#   - SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
#   - OPENAI_API_KEY (or GROQ_API_KEY, depending on ai-router config)
#   - DODO_PAYMENTS_API_KEY, DODO_WEBHOOK_SECRET (for billing + webhook sig verify)
#   - RESEND_API_KEY, RESEND_FROM_EMAIL (for transactional emails)
#   - GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET (Google OAuth sign-in)
#   - ADMIN_SECRET (protects /api/admin/campaigns and /admin ops page)
#
# Optional but recommended:
#   - SENTRY_DSN (server), VITE_SENTRY_DSN (dashboard), SENTRY_DSN_EXT (extension)
#   - GROQ_API_KEY (fallback/co-primary AI provider)
#   - CORS_ORIGINS
#
# All values below are placeholders. Do NOT commit a real .env file; .env* is
# gitignored.

# ----- Core / App -----
NODE_ENV=development
PORT=5000
SESSION_SECRET=generate_a_secure_random_string_here
# Public domain used to build return URLs (defaults to request host in prod):
DOMAIN=localhost:5000

# ----- Supabase (primary datastore) -----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Legacy direct Postgres URL (only needed if you bypass Supabase client):
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
PGDATABASE=dbname
PGHOST=host
PGPORT=5432
PGUSER=user
PGPASSWORD=your_password

# ----- AI providers -----
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ----- Model routing cascade (OpenAI-first with global daily token budgets) -----
# Set MODEL_ROUTING_ENABLED=false to restore legacy Groq-first routing.
MODEL_ROUTING_ENABLED=true
MODEL_ROUTING_TIER1_MODEL=gpt-5-chat-latest
MODEL_ROUTING_TIER1_DAILY_TOKENS=250000
MODEL_ROUTING_TIER2_MODEL=gpt-5.4-mini
MODEL_ROUTING_TIER2_DAILY_TOKENS=2500000
MODEL_ROUTING_TIER3_MODEL=openai/gpt-oss-120b

# ----- Google OAuth -----
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ----- Dodo Payments (billing) -----
# Use test_mode while developing; switch to live_mode for launch.
DODO_PAYMENTS_API_KEY=your_dodo_api_key_here
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_WEBHOOK_SECRET=your_dodo_webhook_secret
DODO_PRICE_WEEKLY=dodo_price_weekly_placeholder
DODO_PRICE_MONTHLY=dodo_price_monthly_placeholder

# ----- Resend (transactional email) -----
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL="TweetReplyAI <noreply@tweetreplyai.com>"
# Optional: webhook signing secret from Resend (Svix) for delivery events.
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret

# ----- Admin / Ops -----
# Used by /api/admin/campaigns and the operator dashboard.
ADMIN_SECRET=generate_a_long_random_admin_secret

# ----- Sentry (error monitoring) -----
# All optional; when unset, the code no-ops so dev and CI remain quiet.
SENTRY_DSN=
# Exposed to the React dashboard bundle; must be prefixed VITE_ for Vite to expose.
VITE_SENTRY_DSN=
# Exposed to the browser extension bundles at build time.
SENTRY_DSN_EXT=
SENTRY_ENVIRONMENT=development
# Optional release tag; CI sets this to the commit SHA.
SENTRY_RELEASE=

# ----- CORS / Networking -----
# Comma-separated origins for /api. Use *.domain.com to allow that domain and all subdomains.
CORS_ORIGINS=https://tweetreplyai.vercel.app,*.tweetreplyai.com,http://localhost:5000,http://localhost:5173,http://127.0.0.1:5000,http://127.0.0.1:5173
REPLIT_DOMAINS=localhost:5000

# ----- Extension (for local development) -----
EXTENSION_API_URL=http://localhost:5000
