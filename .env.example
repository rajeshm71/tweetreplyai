# Required in production: SESSION_SECRET, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
# Optional in development (app uses dev defaults where applicable).

# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
PGDATABASE=dbname
PGHOST=host
PGPORT=5432
PGUSER=user
PGPASSWORD=your_password

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Session Configuration
SESSION_SECRET=generate_a_secure_random_string_here

# Application Configuration
NODE_ENV=development
PORT=5000
REPLIT_DOMAINS=localhost:5000

# Extension Configuration (for local development)
EXTENSION_API_URL=http://localhost:5000
