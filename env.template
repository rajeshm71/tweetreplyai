# Environment Variables Template for Vercel Deployment

# Database
DATABASE_URL=your_supabase_connection_string

# AI Services
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
GROQ_API_KEY=your_groq_api_key

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Session
SESSION_SECRET=your_session_secret

# Environment
NODE_ENV=production

# Whitelist Configuration
# Whitelisted emails that bypass subscription (comma-separated)
# IMPORTANT: Can be updated without code changes. Changes take effect after server restart or within 60 seconds.
# Format: email1@example.com,email2@example.com,email3@example.com
BYPASS_EMAILS=admin@example.com,user1@example.com,user2@example.com

# Limits
# IMPORTANT: These values are read dynamically on each request - can be updated without code changes or restart.
# BYPASS_USER_LIMIT: High limit for whitelisted users (default: 10000)
BYPASS_USER_LIMIT=10000
# TRIAL_LIMIT: Trial limit for regular users (default: 50)
TRIAL_LIMIT=50

# Tweet Analysis Agents
# TWEET_ANALYSIS_ENABLED: Enable/disable AI-powered tweet analysis agents (default: true)
TWEET_ANALYSIS_ENABLED=true
# TWEET_ANALYSIS_CACHE_TTL: Cache TTL in seconds for tweet analysis results (default: 3600 = 1 hour)
TWEET_ANALYSIS_CACHE_TTL=3600
# TWEET_ANALYSIS_MODEL: AI model to use for tweet analysis agents (default: gpt-4o-mini)
TWEET_ANALYSIS_MODEL=gpt-4o-mini
# TWEET_ANALYSIS_MAX_CACHE_SIZE: Maximum number of cached analysis results (default: 1000)
TWEET_ANALYSIS_MAX_CACHE_SIZE=1000
# TWEET_ANALYSIS_TIMEOUT_MS: Timeout in milliseconds for agent API calls (default: 10000 = 10 seconds)
TWEET_ANALYSIS_TIMEOUT_MS=10000