# Environment Variables Template for Vercel Deployment

# Database
DATABASE_URL=your_supabase_connection_string

# AI Services
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
GROQ_API_KEY=your_groq_api_key

# Dodo Payments Configuration
DODO_PAYMENTS_API_KEY=your_dodo_api_key
DODO_WEBHOOK_SECRET=your_dodo_webhook_secret
DODO_PRICE_WEEKLY=prod_subscription_weekly  # Product ID for weekly plan
DODO_PRICE_MONTHLY=prod_subscription_monthly  # Product ID for monthly plan

# Session
SESSION_SECRET=your_session_secret

# Environment
NODE_ENV=production

# Domain Configuration
# DOMAIN: Custom domain for callbacks (optional - Vercel provides VERCEL_URL automatically)
# VERCEL_URL: Automatically provided by Vercel (e.g., tweetreplyai.vercel.app)
# If DOMAIN is not set, VERCEL_URL will be used in production
DOMAIN=your-domain.com  # Optional: Set if you have a custom domain

# Whitelist Configuration
# Whitelisted emails that bypass subscription (comma-separated)
# IMPORTANT: Can be updated without code changes. Changes take effect after server restart or within 60 seconds.
# Format: email1@example.com,email2@example.com,email3@example.com
BYPASS_EMAILS=admin@example.com,user1@example.com,user2@example.com

# Credit Limits
# IMPORTANT: These values are read dynamically on each request - can be updated without code changes or restart.
# NOTE: These limits now represent CREDITS, not replies. Different reply modes cost different credits:
#   - Concise mode: 1 credit
#   - Balanced mode: 2 credits (default)
#   - Enhanced mode: 3 credits
# BYPASS_USER_LIMIT: High credit limit for whitelisted users (default: 10000 credits)
BYPASS_USER_LIMIT=10000
# TRIAL_LIMIT: Trial credit limit for regular users (default: 50 credits)
TRIAL_LIMIT=50
# Plan limits (can be added for future configurability)
# WEEKLY_CREDITS_LIMIT=4000
# MONTHLY_CREDITS_LIMIT=20000

# Tweet Analysis Agents
# TWEET_ANALYSIS_ENABLED: Enable/disable AI-powered tweet analysis agents (default: true)
TWEET_ANALYSIS_ENABLED=true
# TWEET_ANALYSIS_CACHE_TTL: Cache TTL in seconds for tweet analysis results (default: 3600 = 1 hour)
TWEET_ANALYSIS_CACHE_TTL=3600
# TWEET_ANALYSIS_MODEL: AI model to use for tweet analysis agents (default: gpt-4o-mini)
TWEET_ANALYSIS_MODEL=gpt-4o-mini
# TWEET_ANALYSIS_MAX_CACHE_SIZE: Maximum number of cached analysis results (default: 1000)
TWEET_ANALYSIS_MAX_CACHE_SIZE=1000
# TWEET_ANALYSIS_TIMEOUT_MS: Timeout in milliseconds for agent API calls (default: 10000 = 10 seconds)
TWEET_ANALYSIS_TIMEOUT_MS=10000